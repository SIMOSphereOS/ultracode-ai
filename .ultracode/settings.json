{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$ULTRACODE_PROJECT_DIR/.ultracode/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$ULTRACODE_PROJECT_DIR/.ultracode/hooks/guard-bash.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$ULTRACODE_PROJECT_DIR/.ultracode/hooks/protect-paths.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$ULTRACODE_PROJECT_DIR/.ultracode/hooks/lint-changed.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$ULTRACODE_PROJECT_DIR/.ultracode/hooks/verify-on-stop.sh\""
          }
        ]
      }
    ]
  }
}
